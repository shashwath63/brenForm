# Copy to .env.local and fill in. Never commit .env.local.

# Your Claude API key (https://platform.claude.com/settings/keys)
ANTHROPIC_API_KEY=

# Printed by: pnpm setup:voice
VOICE_AGENT_ID=
VOICE_ENVIRONMENT_ID=

# Anyone who knows this can start paid agent work — pick something long.
VOICE_APP_PASSCODE=

# Optional: mount a GitHub repo in every new session so you can say "fix the failing test" etc.
# GITHUB_TOKEN needs read (and write, if you want pushes) access to that repo.
VOICE_GITHUB_REPO_URL=
VOICE_GITHUB_BRANCH=main
GITHUB_TOKEN=
